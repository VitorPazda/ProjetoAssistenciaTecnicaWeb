@model ProjetoAssistenciaTecnicaWeb.Models.Orcamento

@section Styles {
    <link rel="stylesheet" href="~/css/OrcamentoDetail.css" />
}

<h1>Detalhes</h1>
<hr />

<div class="details-container">
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.CodigoOrcamento)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.CodigoOrcamento)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Valor)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Valor)
        </dd>
    </div>
    <div class="actions">
        <a class="btn-edit" asp-action="Edit" asp-route-id="@Model?.IdOrcamento">Editar</a>
        <a class="btn-back" asp-action="Index">Voltar</a>
    </div>
