@model ProjetoAssistenciaTecnicaWeb.Models.ViewModels.OrcamentoFormViewModel

@{
    ViewData["Title"] = "Create";
}

@section Styles {
    <link rel="stylesheet" href="~/css/OrcamentoCreate.css" />
}

<h4>Novo Orçamento</h4>
<hr/>

<div class="pagina-principal">
    <div class="pagina">


        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="general-infos">
                <div class="personal-info">
                    <label asp-for="Orcamento.Valor" class="control-label"></label>
                    <input asp-for="Orcamento.Valor" class="form-control" />
                    <span asp-validation-for="Orcamento.Valor" class="text-danger"></span>
                </div>
                <div class="personal-info">
                    <label asp-for="Orcamento.FuncionarioId"></label>
                    <select asp-for="Orcamento.FuncionarioId"
                            asp-items='@(new SelectList(Model.Funcionarios, "IdFuncionario", "Nome"))'
                            class="form-control">
                        <option value="">Selecione um funcionário</option>
                    </select>
                </div>
                <div class="form-group">
                    <input type="submit" value="Salvar Ordem" class="btn-primary" />
                </div>
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Voltar</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
