@model IEnumerable<ProjetoAssistenciaTecnicaWeb.Models.Orcamento>

@{
    ViewData["Title"] = "Busca";
}

@section Styles {
    <link rel="stylesheet" href="~/css/OrcamentoBuscar.css" />
}

<div class="pagina-principal">
    <div class="pagina-menus">

        <h1 class="titulo">Orçamentos</h1>

        <button asp-action="Create" type="submit" class="botao-buscar">Criar Novo</button>

        <form class="formulario" role="search">
            <div class="general-infos">

                <div class="filtro-infos">
                    <label for="codigoOrcamento">Codigo</label>
                    <input type="text" class="form-control" name="codigoOrcamento" value=@ViewData["codigoOrcamento"] />
                </div>
            </div>
            <button type="submit" class="botao-buscar">
                Filtrar
            </button>
        </form>
    </div>
</div>

<div class="panel panel-primary">
    <div class="panel-body">
        <table class="table table-striped table-hover">
            <thead>
                <tr class="success">
                    <th>
                        @Html.DisplayNameFor(model => model.CodigoOrcamento)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Valor)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.FuncionarioId)
                    </th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            @Html.DisplayFor(modelItem => item.CodigoOrcamento)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.Valor)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.Funcionario.Nome)
                        </td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@item.IdOrcamento">Editar</a>
                            <a asp-action="Details" asp-route-id="@item.IdOrcamento">Detalhes</a>
                            <a asp-action="Delete" asp-route-id="@item.IdOrcamento">Excluir</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>