@model ProjetoAssistenciaTecnicaWeb.Models.ViewModels.ProdutoFormViewModel
@{
    ViewData["Title"] = "Details";
}
@section Styles {
    <link rel="stylesheet" href="~/css/ProdutoDetail.css" />
}

<h1>Detalhes</h1>
<hr />

<div class="details-container">
    <h4>Produtos</h4>
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Produto.Marca)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Produto.Marca)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Produto.Modelo)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Produto.Modelo)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Produto.NSerie)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Produto.NSerie)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Produto.Condicao)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Produto.Condicao)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Produto.Cliente.Nome)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Produto.Cliente.Nome)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Produto.Cliente.CPF_CNPJ)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Produto.Cliente.CPF_CNPJ)
        </dd>
    </dl>
</div>
<div class="actions">
    <a class="btn-edit" asp-action="Edit" asp-route-id="@Model?.Produto.IdProduto">Editar</a>
    <a class="btn-back" asp-action="Index">Voltar</a>
</div>
